{
  "name": "passage",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @passage/desktop build && go run ./desktop",
    "build:desktop": "pnpm --filter @passage/desktop build && go build -o desktop/build/passage ./desktop",
    "dev:extension": "pnpm --filter @passage/extension dev",
    "build:extension": "pnpm --filter @passage/extension build",
    "check": "pnpm -r check"
  }
}
